---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { livePosts, seriesPosts, isLive, urlOf, topicOf, slugOf, fmtDate, postDate, pad, type Post } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await livePosts();
  return posts.map((p) => ({ params: { topic: topicOf(p), slug: slugOf(p) }, props: { post: p } }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const topic = await getEntry('topics', topicOf(post));
const series = post.data.series ? await getEntry('series', post.data.series) : undefined;
const siblings = series ? await seriesPosts(series.id) : [];
const idx = siblings.findIndex((p) => p.id === post.id);
const prev = idx > 0 ? siblings[idx - 1] : undefined;
const next = idx >= 0 && idx < siblings.length - 1 ? siblings[idx + 1] : undefined;
const week = series?.data.weeks.find((w) => w.week === post.data.week);
const hashtagUrl = series?.data.hashtag
  ? `https://www.linkedin.com/feed/hashtag/${series.data.hashtag.replace('#', '').toLowerCase()}/`
  : undefined;
const title = series ? `Day ${post.data.day}: ${post.data.title}` : post.data.title;
---
<Base
  title={`${title} | ${series?.data.title ?? topic?.data.title}`}
  description={post.data.summary}
  accent={topic?.data.accent}
  accentDark={topic?.data.accentDark}
  image={post.data.diagram}
>
  <div class="wrap layout">
    <article>
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={`/${topicOf(post)}/`}>{topic?.data.title}</a>
        {series && <><span aria-hidden="true">/</span><a href={`/${topicOf(post)}/#${series.id}`}>{series.data.title}</a></>}
      </nav>

      <header class="post-head">
        {series && (
          <p class="eyebrow day">
            Day {post.data.day} of {series.data.totalDays}
            {week && <> · {series.data.groupLabel} {week.week}: {week.theme}</>}
          </p>
        )}
        <h1>{post.data.title}</h1>
        {post.data.summary && <p class="lead">{post.data.summary}</p>}
        <div class="meta">
          <time datetime={post.data.date.toISOString()}>{postDate(post, series, true)}</time>
          {post.data.updated && <span>Updated {fmtDate(post.data.updated)}</span>}
          {post.data.linkedin ? (
            <a class="li" href={post.data.linkedin}>Read the LinkedIn post ↗</a>
          ) : hashtagUrl ? (
            <a class="li" href={hashtagUrl}>Follow {series?.data.hashtag} on LinkedIn ↗</a>
          ) : null}
        </div>
      </header>

      {post.data.diagram && (
        <figure class="diagram">
          <a href={post.data.diagram}><img src={post.data.diagram} alt={post.data.diagramAlt ?? ''} loading="eager" /></a>
          <figcaption>Select the diagram to open it full size.</figcaption>
        </figure>
      )}

      <div class="prose">
        <Content />
      </div>

      {(prev || next) && (
        <nav class="pager" aria-label="Series navigation">
          {prev ? (
            isLive(prev)
              ? <a class="pg prev" href={urlOf(prev)}><span>← Day {prev.data.day}</span>{prev.data.title}</a>
              : <span class="pg prev off"><span>← Day {prev.data.day}</span>{prev.data.title}</span>
          ) : <span></span>}
          {next && (
            isLive(next)
              ? <a class="pg next" href={urlOf(next)}><span>Day {next.data.day} →</span>{next.data.title}</a>
              : <span class="pg next off"><span>Day {next.data.day} · coming {fmtDate(next.data.date, { month: 'short', day: 'numeric' })}</span>{next.data.title}</span>
          )}
        </nav>
      )}
    </article>

    {series && (
      <aside class="toc" aria-label={`${series.data.title}, all days`}>
        <p class="eyebrow">{series.data.title}</p>
        {series.data.weeks.map((w) => (
          <div class="toc-week">
            <p class="toc-wk">{series.data.groupLabel} {w.week} · {w.theme}</p>
            <ol>
              {siblings.filter((p) => p.data.week === w.week).map((p) => (
                <li class={p.id === post.id ? 'cur' : isLive(p) ? '' : 'off'}>
                  {isLive(p) && p.id !== post.id
                    ? <a href={urlOf(p)}><b>{pad(p.data.day ?? 0)}</b> {p.data.title}</a>
                    : <span aria-current={p.id === post.id ? 'page' : undefined}><b>{pad(p.data.day ?? 0)}</b> {p.data.title}</span>}
                </li>
              ))}
            </ol>
          </div>
        ))}
      </aside>
    )}
  </div>
</Base>

<style>
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 280px; gap: 64px; padding-top: 40px; }
  @media (max-width: 960px) { .layout { grid-template-columns: minmax(0, 1fr); gap: 48px; } }
  article { min-width: 0; }
  .crumbs { display: flex; flex-wrap: wrap; gap: 8px; font-size: 15px; color: var(--muted); }
  .crumbs a { color: var(--muted); }
  .post-head { margin-top: 24px; max-width: 70ch; }
  .day { color: var(--accent); }
  h1 { font-size: clamp(2rem, 4.5vw, 3rem); line-height: 1.08; letter-spacing: -0.03em; margin: 10px 0 16px; }
  .lead { font-size: 1.2rem; color: var(--ink-2); margin: 0; }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 20px; margin-top: 20px; font-size: 15px; color: var(--muted); }
  .li {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 16px; border-radius: 8px;
    background: var(--accent); color: #fff; font-weight: 600; text-decoration: none;
  }
  @media (prefers-color-scheme: dark) { .li { color: #0b0b0b; } }
  .li:hover { background: var(--ink); color: var(--paper); }
  .diagram { margin: 36px 0 8px; }
  .diagram img { border: 1px solid var(--line); border-radius: 12px; width: 100%; max-width: 760px; }
  .diagram figcaption { font-size: 14px; color: var(--muted); margin-top: 8px; }
  .prose { margin-top: 32px; }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 64px; max-width: 70ch; }
  .pg { display: flex; flex-direction: column; gap: 4px; padding: 16px 18px; border: 1px solid var(--line); border-radius: 10px; text-decoration: none; font-weight: 600; line-height: 1.3; }
  .pg span { font-family: var(--mono); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); font-weight: 600; }
  a.pg:hover { border-color: var(--accent); }
  .pg.next { text-align: right; grid-column: 2; }
  .pg.off { color: var(--muted); }
  .pg.off span { color: var(--muted); }
  @media (max-width: 600px) { .pager { grid-template-columns: 1fr; } .pg.next { grid-column: 1; text-align: left; } }
  .toc { position: sticky; top: 88px; align-self: start; font-size: 15px; max-height: calc(100vh - 110px); overflow-y: auto; padding-bottom: 24px; }
  @media (max-width: 960px) { .toc { position: static; max-height: none; border-top: 1px solid var(--line); padding-top: 32px; } }
  .toc-week { margin-top: 18px; }
  .toc-wk { margin: 0 0 4px; font-weight: 700; font-size: 14px; }
  .toc ol { list-style: none; margin: 0; padding: 0; }
  .toc li a, .toc li span { display: block; padding: 5px 0 5px 12px; border-left: 2px solid var(--line); text-decoration: none; line-height: 1.35; }
  .toc li a:hover { border-left-color: var(--accent); }
  .toc b { font-family: var(--mono); font-size: 12px; color: var(--accent); margin-right: 4px; }
  .toc li.cur span { border-left-color: var(--accent); font-weight: 700; }
  .toc li.off span { color: var(--muted); }
  .toc li.off b { color: var(--muted); }
</style>
