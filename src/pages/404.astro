---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <div class="wrap" style="padding-top: 80px">
    <p class="eyebrow">404</p>
    <h1 style="font-size: 2.6rem; letter-spacing: -0.02em; margin: 8px 0 16px">That page isn't here.</h1>
    <p>If you followed a link from LinkedIn, the post may not be published yet. Series posts go live on their scheduled day.</p>
    <p><a href="/">Back to the home page</a></p>
  </div>
</Base>
