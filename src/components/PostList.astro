---
import { getEntry } from 'astro:content';
import { urlOf, topicOf, fmtDate, type Post } from '../lib/content';

interface Props { posts: Post[] }
const { posts } = Astro.props;
const rows = await Promise.all(
  posts.map(async (p) => {
    const s = p.data.series ? await getEntry('series', p.data.series) : undefined;
    const t = await getEntry('topics', topicOf(p));
    return { p, kicker: s ? `${s.data.title} · Day ${p.data.day}` : t?.data.title ?? '' };
  }),
);
---
<ol class="list">
  {rows.map(({ p, kicker }) => (
    <li>
      <a href={urlOf(p)}>
        <span class="k">{kicker}</span>
        <span class="t">{p.data.title}</span>
        {p.data.summary && <span class="s">{p.data.summary}</span>}
      </a>
      <time datetime={p.data.date.toISOString()}>{fmtDate(p.data.date)}</time>
    </li>
  ))}
</ol>

<style>
  .list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  li { display: flex; justify-content: space-between; gap: 24px; padding: 20px 0; border-bottom: 1px solid var(--line); }
  a { display: flex; flex-direction: column; gap: 4px; text-decoration: none; }
  a:hover .t { text-decoration: underline; text-decoration-color: var(--red); }
  .k { font-family: var(--mono); font-size: 12px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  .t { font-size: 1.2rem; font-weight: 700; line-height: 1.3; }
  .s { color: var(--ink-2); font-size: 16px; }
  time { flex: none; font-size: 14px; color: var(--muted); padding-top: 22px; }
  @media (max-width: 600px) { li { flex-direction: column; gap: 6px; } time { padding: 0; } }
</style>
