---
import { getEntry } from 'astro:content';
import { seriesPosts, isLive, urlOf, type Series } from '../lib/content';

interface Props { series: Series }
const { series } = Astro.props;
const topic = await getEntry('topics', series.data.topic);
const posts = await seriesPosts(series.id);
const live = posts.filter((p) => isLive(p));
const liveDays = new Set(live.map((p) => p.data.day));
const total = series.data.totalDays;
const latest = live.at(-1);

let status = '';
if (live.length === 0) status = series.data.note ? 'Coming soon' : 'Starting soon';
else if (live.length < total) status = `Running now · Day ${latest?.data.day} of ${total}`;
else status = `Complete · ${total} posts`;

const accent = topic?.data.accent ?? 'var(--red)';
const accentDark = topic?.data.accentDark ?? accent;
---
<article class="card" style={`--c:${accent};--cd:${accentDark}`}>
  <p class="eyebrow">{topic?.data.title}</p>
  <h3><a href={`/${series.data.topic}/`}>{series.data.title}</a></h3>
  <p class="desc">{series.data.description}</p>
  <div class="meter" role="img" aria-label={`${live.length} of ${total} days published`}>
    {Array.from({ length: total }, (_, i) => <span class={liveDays.has(i + 1) ? 'on' : ''}></span>)}
  </div>
  <div class="foot">
    <span class="status">{status}</span>
    {latest && <a class="latest" href={urlOf(latest)}>Latest: Day {latest.data.day} →</a>}
  </div>
</article>

<style>
  .card {
    display: flex; flex-direction: column; gap: 12px;
    padding: 28px; border: 1px solid var(--line); border-radius: 14px; background: var(--paper);
    border-top: 5px solid var(--c);
  }
  @media (prefers-color-scheme: dark) { .card { border-top-color: var(--cd); } .meter span.on { background: var(--cd) !important; } }
  h3 { margin: 0; font-size: 1.6rem; line-height: 1.2; letter-spacing: -0.015em; }
  h3 a { text-decoration: none; }
  h3 a:hover { text-decoration: underline; text-decoration-color: var(--c); }
  .desc { margin: 0; color: var(--ink-2); font-size: 16px; }
  .meter { display: grid; grid-template-columns: repeat(auto-fill, minmax(10px, 1fr)); gap: 3px; margin-top: 4px; }
  .meter span { height: 8px; border-radius: 2px; background: var(--line); }
  .meter span.on { background: var(--c); }
  .foot { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; font-size: 15px; margin-top: auto; }
  .status { font-family: var(--mono); font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); padding: 10px 0; }
  .latest { padding: 10px 0; font-weight: 600; }
</style>
