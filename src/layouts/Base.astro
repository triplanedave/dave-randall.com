---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { allTopics } from '../lib/content';

interface Props {
  title: string;
  description?: string;
  accent?: string;
  accentDark?: string;
  image?: string;
}
const {
  title,
  description = 'Practical Intune guidance from Dave Randall: the deep dives behind his LinkedIn series on RBAC, Microsoft Graph, and more.',
  accent,
  accentDark,
  image = '/images/og-default.png',
} = Astro.props;

const topics = await allTopics();
const path = Astro.url.pathname;
const fullTitle = title === 'Dave Randall' ? title : `${title} · Dave Randall`;
const canonical = new URL(path, Astro.site);
const ogImage = new URL(image, Astro.site);
const accentStyle = accent ? `--accent-light:${accent};--accent-dark:${accentDark ?? accent}` : undefined;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en" style={accentStyle}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title="Dave Randall" href="/rss.xml" />
  <meta property="og:type" content="article" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap bar">
      <a class="brand" href="/" aria-label="Dave Randall, home">
        <Logo size={26} label="" />
        <span>Dave Randall</span>
      </a>
      <nav aria-label="Main">
        <ul>
          {topics.map((t) => (
            <li><a href={`/${t.id}/`} aria-current={path.startsWith(`/${t.id}/`) ? 'page' : undefined}>{t.data.navLabel}</a></li>
          ))}
          <li><a href="/about/" aria-current={path.startsWith('/about/') ? 'page' : undefined}>About</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap foot">
      <div class="foot-brand">
        <Logo size={22} label="" />
        <div>
          <p class="foot-co">Thunder Creek Creative Solutions</p>
          <p class="foot-small">© {year} Dave Randall. Code samples MIT-licensed; posts and diagrams <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.</p>
        </div>
      </div>
      <ul class="foot-links">
        <li><a href="https://www.linkedin.com/in/dave-randall-6636333/">LinkedIn</a></li>
        <li><a href="https://github.com/triplanedave">GitHub</a></li>
        <li><a href="/rss.xml">RSS</a></li>
      </ul>
    </div>
  </footer>
</body>
</html>

<style>
  .site-header { border-bottom: 1px solid var(--line); background: var(--paper); position: sticky; top: 0; z-index: 5; }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 64px; flex-wrap: wrap; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 700; font-size: 19px; letter-spacing: -0.01em; }
  .brand:hover { color: var(--ink); }
  nav ul { list-style: none; display: flex; gap: 4px; margin: 0; padding: 0; }
  nav a {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 12px;
    font-family: var(--mono); font-size: 14px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase;
    text-decoration: none; color: var(--ink-2); border-radius: 6px;
  }
  nav a:hover { color: var(--ink); background: var(--paper-2); }
  nav a[aria-current='page'] { color: var(--ink); box-shadow: inset 0 -3px 0 var(--red); border-radius: 0; }
  @media (max-width: 520px) {
    .bar { min-height: 56px; }
    nav a { padding: 0 8px; font-size: 13px; }
    .brand span { font-size: 17px; }
  }

  .site-footer { border-top: 1px solid var(--line); margin-top: 96px; padding: 40px 0 48px; background: var(--paper-2); }
  .foot { display: flex; justify-content: space-between; gap: 24px; flex-wrap: wrap; align-items: flex-start; }
  .foot-brand { display: flex; gap: 14px; align-items: flex-start; }
  .foot-brand :global(svg) { margin-top: 4px; flex: none; }
  .foot-co { margin: 0; font-weight: 700; }
  .foot-small { margin: 4px 0 0; font-size: 14px; color: var(--muted); max-width: 52ch; }
  .foot-small a { color: var(--muted); }
  .foot-links { list-style: none; display: flex; gap: 20px; margin: 0; padding: 0; font-size: 15px; }
  .foot-links a { display: inline-block; padding: 10px 0; }
</style>
